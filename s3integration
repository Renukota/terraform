pipeline{
    agent any
    tools{
        maven 'mymaven'
    }
    stages{
        stage("Code"){
            steps{
                git branch: 'master', url: 'https://github.com/Renukota/one.git'
            }
        }
        stage("Build"){
            steps{
                sh "mvn clean package -DskipTests"
            }
        }
        stage("Test"){
            steps{
                sh 'mvn test'
            }
        }
        stage("Artifact"){
            steps{
                s3Upload consoleLogLevel: 'INFO', dontSetBuildResultOnFailure: false, dontWaitForConcurrentBuildCompletion: false, entries: [[bucket: 'kat-kops-2026', excludedFile: '', flatten: false, gzipFiles: false, keepForever: false, managedArtifacts: false, noUploadOnFailure: true, selectedRegion: 'us-east-2', showDirectlyInBrowser: false, sourceFile: 'target/*.war', storageClass: 'STANDARD', uploadFromSlave: false, useServerSideEncryption: false]], pluginFailureResultConstraint: 'FAILURE', profileName: 's3Integration', userMetadata: []
            }
        }
    }
}
