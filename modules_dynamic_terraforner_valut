resource "aws_security_group" "mysg" {
  name = "mysg1"

  dynamic "ingress" {
    for_each = var.port
    content {
      to_port    = ingress.value
      from_port  = ingress.value
      protocol   = "tcp"
      cidr_blocks = ["0.0.0.0/0"]
    }
  }
  egress {
    to_port    = 0
    from_port  = 0
    protocol   = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

}

variable "port" {
  type    = list(number)
  default = [22, 8080, 3306, 80]
}

